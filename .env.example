# Local values that work with `docker compose -f compose.dev.yaml up -d` and `pnpm start:dev`,
# which loads .env. Copy this file to .env for local work; .env is never committed.
# When 6379 is taken on the host, start the stack with DEV_REDIS_PORT set and use the same port below.
# Every variable is validated at start-up: a missing or invalid one stops the gateway with a
# ConfigError that names it.

# Runtime environment: development, test or production (the default).
NODE_ENV=development
# Port of the public HTTP API.
PORT=3000
# trace, debug, info (the default), warn, error, fatal or silent.
LOG_LEVEL=info
# true writes readable lines through pino-pretty instead of JSON; refused in production.
LOG_PRETTY=false
# Collector of traces and metrics, an http or https URL. Empty: spans still give the logs their
# trace ids, and nothing is exported.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Redis, for the per-token rate-limit counters.
REDIS_URL=redis://localhost:6379

# Browser origins allowed to call the API with the session cookie, comma-separated, exact (no path,
# no trailing slash, never *): the web application and the website. These are the hosts of the
# cadenway-ops local stack; add the address of a development server when you run one.
ALLOWED_ORIGINS=http://app.cadenway.localhost,http://cadenway.localhost

# Internal token: the gateway signs the calls it makes to the services with its own Ed25519 key.
# No private key is committed, not even a development one: the gateway refuses to start until
# INTERNAL_TOKEN_PRIVATE_JWK holds one. To get one, from ../cadenway-ops/compose, once its .env
# exists (`cp .env.example .env` there: it names the file that defines the key generator):
#   docker compose run --rm internal-token-keys --print
# prints a fresh pair per issuer on the terminal and writes nothing; put the value of
# API_GATEWAY_INTERNAL_TOKEN_PRIVATE_JWK here, between single quotes. A service run on the host
# trusts the gateway once its INTERNAL_TOKEN_TRUSTED_ISSUERS lists the public key of that pair.
INTERNAL_TOKEN_ISSUER=api-gateway
INTERNAL_TOKEN_PRIVATE_JWK=

# Base URL of each internal service run on the host with its own `pnpm start:dev`, at the local
# port its repository documents. The routes of the authentication call identity-service.
IDENTITY_SERVICE_URL=http://localhost:3010
ORGANIZATION_SERVICE_URL=http://localhost:3011
BILLING_SERVICE_URL=http://localhost:3012
TASK_SERVICE_URL=http://localhost:3013
DOCUMENT_SERVICE_URL=http://localhost:3014
STORAGE_SERVICE_URL=http://localhost:3015
NOTIFICATION_SERVICE_URL=http://localhost:3016
AUTOMATION_SERVICE_URL=http://localhost:3017
INTEGRATION_SERVICE_URL=http://localhost:3018
SEARCH_SERVICE_URL=http://localhost:3019
