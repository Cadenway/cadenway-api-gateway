# Local values that work with `docker compose -f compose.dev.yaml up -d`.
# Copy this file to .env for local work; .env is never committed.
# When 6379 is taken on the host, start the stack with DEV_REDIS_PORT set and use the same port below.

# Port of the public HTTP API.
PORT=3000

# Redis, for the per-token rate-limit counters.
REDIS_URL=redis://localhost:6379
