{
  "name": "cadenway-api-gateway",
  "version": "0.3.0",
  "description": "Cadenway API gateway: the only API the applications see (auth, scopes, routing, aggregates, rate limit).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": "^24.15.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "start:dev": "nest start --watch --env-file .env --exec \"node --max-old-space-size=160 --import @cadenway/nest-common/register --import ./dist/telemetry.js\"",
    "build": "nest build",
    "generate:clients": "orval --config orval.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test:lint": "node --test tests/lint/eslint-rules.test.mjs",
    "test:architecture": "node --test tests/architecture/project.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "quality": "pnpm format:check && pnpm test:lint && pnpm lint && pnpm typecheck && pnpm test:architecture && pnpm test:coverage && pnpm build"
  },
  "dependencies": {
    "@cadenway/contracts": "0.20.0",
    "@cadenway/nest-common": "0.11.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@opentelemetry/api": "^1.10.0",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "rate-limiter-flexible": "^11.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cadenway/nest-testing": "0.5.1",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.2",
    "@testcontainers/redis": "^12.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.5",
    "globals": "^17.14.0",
    "msw": "^3.0.5",
    "orval": "^8.48.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
